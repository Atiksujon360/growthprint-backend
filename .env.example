# Database Configuration
# Copy this file to .env and fill in actual values for local development
# Do not commit .env or any file containing real credentials

# Environment Variable Loading
# This project uses springboot4-dotenv (Spring Boot 4.1.1 compatible) to load .env files automatically.
# If .env exists in the project root, it will be loaded at application startup.
# Alternatively, set environment variables directly in your OS or IDE.

# Local development: Render PostgreSQL external connection
# Replace YOUR_EXTERNAL_HOST with the complete hostname from Render's External Database URL
# The JDBC URL must start with jdbc:postgresql://
# Never embed database credentials inside DATABASE_URL
DATABASE_URL=jdbc:postgresql://YOUR_EXTERNAL_HOST:5432/YOUR_DATABASE?sslmode=require
DATABASE_USERNAME=YOUR_DATABASE_USER
DATABASE_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# JWT Configuration (REQUIRED - the app will not start without it; there is no default)
# Generate a secure random key: openssl rand -base64 64
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE_MIN_32_CHARS

# AI provider keys are entered by an admin in Settings -> AI providers and stored encrypted.
# This is the encryption key for them (base64 of 32 random bytes): openssl rand -base64 32
# Optional: without it, AI simply can't be configured; nothing else is affected.
AI_CREDENTIALS_ENCRYPTION_KEY=

# CORS: comma-separated list of allowed frontend origins ('*' is rejected)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Swagger UI / OpenAPI docs: set to false in staging and production
SPRINGDOC_ENABLED=true

# Seller details on invoice PDFs (all optional; leave empty to omit that block from the PDF).
# Use your REAL details only - nothing is invented. Separate lines in multi-line values with \n.
COMPANY_NAME=GrowthPrint
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_TAX_ID=
COMPANY_REGISTRATION_NUMBER=
# e.g. COMPANY_PAYMENT_INSTRUCTIONS=Bank transfer to <your account>\nPlease quote the invoice number
COMPANY_PAYMENT_INSTRUCTIONS=

# For Render deployment:
# Set these variables in the deployed backend service's Environment settings in the Render dashboard
# Use the internal connection URL from Render's Connect tab when deploying on Render
# The internal hostname is for Render services in the same region; external hostname is for local development

# PowerShell (without .env):
# $env:DATABASE_URL="jdbc:postgresql://..."
# $env:DATABASE_USERNAME="..."
# $env:DATABASE_PASSWORD="..."
# $env:JWT_SECRET="..."
# .\mvnw.cmd spring-boot:run

# IntelliJ IDEA:
# Run -> Edit Configurations -> Environment variables -> Add DATABASE_URL, DATABASE_USERNAME, DATABASE_PASSWORD, JWT_SECRET
