# Database Configuration
# Copy this file to .env and fill in actual values for local development
# Do not commit .env or any file containing real credentials

# Environment Variable Loading
# This project uses springboot4-dotenv (optional dependency) to load .env files automatically.
# If .env exists in the project root, it will be loaded at application startup.
# Alternatively, set environment variables directly in your OS or IDE.

# Local development: Render PostgreSQL external connection
# Replace YOUR_EXTERNAL_HOST with the complete hostname from Render's External Database URL
# The JDBC URL must start with jdbc:postgresql://
# Never embed database credentials inside DATABASE_URL
DATABASE_URL=jdbc:postgresql://dpg-dbcdk6l9fdbs73cmcijg-a.singapore-postgres.render.com:5432/growthprint?sslmode=require
DATABASE_USERNAME=growthprint_user
DATABASE_PASSWORD=N2mhZT6IgE87dwSHCMhbh6odNSMBpC38

# For Render deployment:
# Set these variables in the deployed backend service's Environment settings in the Render dashboard
# Use the internal connection URL from Render's Connect tab when deploying on Render
# The internal hostname is for Render services in the same region; external hostname is for local development

# PowerShell (without .env):
# $env:DATABASE_URL="jdbc:postgresql://..."
# $env:DATABASE_USERNAME="..."
# $env:DATABASE_PASSWORD="..."
# .\mvnw.cmd spring-boot:run

# IntelliJ IDEA:
